+	if (!rpmh_write(iovdd_address, iovdd_data, 3) || !rpmh_write(avdd_address, avdd_data, 3)) {
+		return false;
+	}
+	printf("goodix: lisa touch supplies on (iovdd 1.8 V, avdd 3.0 V)\n");
+	return true;
