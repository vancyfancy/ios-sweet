+static bool
+touch_supplies_on(void)
+{
+	uint32_t iovdd = rpmh_address("ldoc2");
+	uint32_t avdd = rpmh_address("ldoc7");
+	uint32_t iovdd_address[3] = { iovdd + VRM_VOLTAGE, iovdd + VRM_ENABLE, iovdd + VRM_MODE };
+	uint32_t avdd_address[3] = { avdd + VRM_VOLTAGE, avdd + VRM_ENABLE, avdd + VRM_MODE };
+	uint32_t iovdd_data[3] = { 1800, 1, VRM_MODE_LDO_HPM };
+	uint32_t avdd_data[3] = { 3000, 1, VRM_MODE_LDO_HPM };
