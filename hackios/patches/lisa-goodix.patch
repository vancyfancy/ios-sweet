+	/* addresses of regulators ("VRM") have 4 in bits 19:16; anything else is not what we are looking for */
+	if (iovdd == 0 || (iovdd >> 16 & 0xf) != 4 || avdd == 0 || (avdd >> 16 & 0xf) != 4) {
