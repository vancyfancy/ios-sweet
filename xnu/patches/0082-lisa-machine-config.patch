+/*
+ * Board config for the Xiaomi Mi 11 Lite 5G NE ("lisa", Qualcomm SM7325-Abyss /
+ * Snapdragon 778G): Kryo 670 = 4x Cortex-A55 + 4x Cortex-A78, ARMv8.2+
+ * (A78 is v8.4 but the shared code path stays at v8.2), no PAC use.
+ *
+ * Same shape as SWEET: generic ARM (no APPLE_ARM64_ARCH_FAMILY: none of
+ * Apple's implementation-defined system registers exist), 16K pages, GICv3
+ * with two security states; Group 0 belongs to TrustZone, so every interrupt,
+ * including the timer, is a Group 1 IRQ taken through sleh_irq().
+ */
+
+#ifndef _PEXPERT_ARM64_LISA_H
