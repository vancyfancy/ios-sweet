+/*
+ * Common board config for Qualcomm SoCs running XNU (sweet = SM7150,
+ * lisa = SM7325). Generic to the family: generic ARM like BCM2837 (no
+ * APPLE_ARM64_ARCH_FAMILY: none of Apple's implementation-defined system
+ * registers exist), 16K pages and GICv3 like VMAPPLE. Unlike VMAPPLE the
+ * GIC has two security states (GICD_TYPER SecurityExtn=1): Group 0 belongs
+ * to TrustZone, so every interrupt, including the timer, is a Group 1 IRQ
+ * taken through sleh_irq().
+ */
+
+#ifndef _PEXPERT_ARM64_QCOM_H
+#define _PEXPERT_ARM64_QCOM_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+/* QCOM-generic code paths key on this (was SWEET in the single-device era). */
+#define QCOM                      1
+
+/*
+ * All eight cores (SM7150: 6x A55 + 2x A76, SM7325: 4x A55 + 4x A78) as one
+ * homogeneous SMP cluster: cpus=N is clamped here. Same 64-byte lines, PSCI
+ * CPU_ON; the scheduler does not know some cores are faster (no AMP/P-E
+ * clusters yet).
+ */
+#define SWEET_SMP_MAX_CPUS         8
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM_PAN_AVAILABLE__     1
+#define __ARM_16K_PG__            1
+
+#define HAS_GIC_V3                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/*
+ * Qualcomm numbers the architected timer PPIs 1/2/3/0 (secure phys, phys,
+ * virt, hyp) instead of the usual 13/14/11/10: the virtual timer XNU uses
+ * (CNTV) is INTID 16 + 3 = 19.
+ */
+#define QCOM_VTIMER_INTID         19
+#define QCOM_IPI_SGI              1       // SGI used for cross-CPU signals
+
+#define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
+
+#define GICR_PE_SIZE              0x20000 // Size of each redistributor region
+
+/* GICv3 register definitions; see GICv3 spec (Arm IHI 0069G) */
+#define GICD_CTLR                 0x0
+
